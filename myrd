#!/usr/bin/env bash

set -u

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/xfreerdp3-login"
PROFILES_DIR="$CONFIG_DIR/profiles"

DEFAULT_PORT="3389"

TARGET_IP=""
PORT=""
USERNAME=""
PASSWORD=""
PROFILE_LOADED=false

usage() {
    echo "Usage: $0 [username] [password] [target_ip] [port]"
    echo "Run without arguments to access the interactive profile menu."
    echo "Port defaults to $DEFAULT_PORT (RDP default) when not specified."
    exit 1
}

check_dependencies() {
    if ! command -v xfreerdp3 >/dev/null 2>&1; then
        echo "Error: xfreerdp3 is not installed or not in PATH."
        exit 127
    fi

    if ! command -v base64 >/dev/null 2>&1; then
        echo "Error: base64 is not installed or not in PATH."
        exit 127
    fi

    # Check if X is NOT running, and if so, ensure startx is available
    if [[ -z "${DISPLAY:-}" ]] && ! command -v startx >/dev/null 2>&1; then
        echo "Error: X server is not running and startx is not installed."
        exit 127
    fi
}

ask_for_targetip() {
    local targetip=""
    read -r -p "Target IP: " targetip
    printf '%s' "$targetip"
}

ask_for_username() {
    local username=""
    read -r -p "Username: " username
    printf '%s' "$username"
}

ask_for_port() {
    local port=""
    while true; do
        read -r -p "Port [$DEFAULT_PORT]: " port
        if [[ -z "$port" ]]; then
            port="$DEFAULT_PORT"
            break
        fi
        if [[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )); then
            break
        fi
        echo "Invalid port. Enter a number between 1 and 65535." >&2
    done
    printf '%s' "$port"
}

ask_for_password() {
    local password=""
    local char=""
    local charset="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*"

    # We will use this to remember how many chars were printed per keystroke
    # so we can delete the correct amount if the user presses Backspace.
    local mask_lengths=""

    printf "Password: " >&2

    while IFS= read -r -s -n 1 char; do
        if [[ -z $char ]]; then
            printf '\n' >&2
            break
        elif [[ $char == $'\x7f' || $char == $'\x08' ]]; then
            if [[ -n $password ]]; then

                # Remove the last character from the actual password
                password="${password%?}"

                # Look up how many random characters were printed for this keystroke
                local n_to_delete="${mask_lengths: -1}"

                # Remove that number from our tracking string
                mask_lengths="${mask_lengths%?}"

                # Erase exactly that many characters from the screen
                for ((i=0; i<n_to_delete; i++)); do
                    printf '\b \b' >&2
                done
            fi
        else
            # Append typed character to the real password
            password+="$char"

            # Generate a random number between 1 and 3
            local n_mask=$(( (RANDOM % 3) + 1 ))

            # Save this number so Backspace knows about it later
            mask_lengths+="$n_mask"

            # Print that many random characters to the screen
            for ((i=0; i<n_mask; i++)); do
                local random_char="${charset:RANDOM%${#charset}:1}"
                printf '%s' "$random_char" >&2
            done
        fi
    done

    # Output the real password silently
    printf '%s' "$password"
}

load_profile() {
    local prof_name="$1"
    local file="$PROFILES_DIR/$prof_name"

    TARGET_IP="$(sed -n '1p' "$file" | base64 -d 2>/dev/null)"
    USERNAME="$(sed -n '2p' "$file" | base64 -d 2>/dev/null)"
    PASSWORD="$(sed -n '3p' "$file" | base64 -d 2>/dev/null)"
    PORT="$(sed -n '4p' "$file" | base64 -d 2>/dev/null)"

    # Profiles created before port support won't have line 4; fall back.
    [[ -z "$PORT" ]] && PORT="$DEFAULT_PORT"
}

save_profile() {
    local prof_name="$1"
    local file="$PROFILES_DIR/$prof_name"

    {
        printf '%s' "$TARGET_IP" | base64 | tr -d '\n'
        printf '\n'
        printf '%s' "$USERNAME" | base64 | tr -d '\n'
        printf '\n'
        printf '%s' "$PASSWORD" | base64 | tr -d '\n'
        printf '\n'
        printf '%s' "$PORT" | base64 | tr -d '\n'
        printf '\n'
    } > "$file"

    chmod 600 "$file"
}

edit_profile() {
    local prof_name="$1"
    load_profile "$prof_name"

    echo ""
    echo "Editing profile: $prof_name"
    echo "(Leave blank and press Enter to keep current value)"

    local new_ip=""
    read -r -p "Target IP [$TARGET_IP]: " new_ip
    [[ -n "$new_ip" ]] && TARGET_IP="$new_ip"

    local new_port=""
    read -r -p "Port [$PORT]: " new_port
    [[ -n "$new_port" ]] && PORT="$new_port"

    local new_user=""
    read -r -p "Username [$USERNAME]: " new_user
    [[ -n "$new_user" ]] && USERNAME="$new_user"

    local password=""
    password="$(ask_for_password)"
    echo ""
    [[ -n "$password" ]] && PASSWORD="$password"

    save_profile "$prof_name"
    echo "Profile '$prof_name' updated successfully."
}

get_credentials() {
    # If passed via arguments, bypass the menu
    if [[ $# -ge 2 ]]; then
        USERNAME="$1"
        PASSWORD="$2"
        TARGET_IP="${3:-}"
        PORT="${4:-$DEFAULT_PORT}"
        if [[ -z "$TARGET_IP" ]]; then
            TARGET_IP="$(ask_for_targetip)"
        fi
        return
    fi

    # Interactive Menu
    while true; do
        clear
        echo ""
        cat << 'EOF'
                                                       )      ((     (
                                                      (        ))     )
                                                      )       )      //     (
    ____                        __                       _   (        __    (      ~->>
   / __ \___  ____ ___  ____  / /____              ,-----' |__,_~~___<'__`)-~__--__-~->> <
  / /_/ / _ \/ __ `__ \/ __ \/ __/ _ \             | //  : | -__   ~__ o)____)),__ - '> >-  >
 / _, _/  __/ / / / / / /_/ / /_/  __/             | //  : |- \_ \ -\_\ -\ \ \ ~\_  \ ->> - ,  >>
/_/ |_|\___/_/ /_/ /_/\____/\__/\___/              | //  : |_~_\ -\__\ \~'\ \ \, \__ . -<-  >>
    ____            __   __                        `-----._| `  -__`-- - ~~ -- ` --~> >
   / __ \___  _____/ /__/ /_____  ____             _/___\_    //)_`//  | ||]
  / / / / _ \/ ___/ //_/ __/ __ \/ __ \      _____[_______]_[~~-_ (.L_/  ||
 / /_/ /  __(__  ) ,< / /_/ /_/ / /_/ /     [____________________]' `\_,/'/
/_____/\___/____/_/|_|\__/\____/ .___/        ||| /          |||  ,___,'./
                               /_/            ||| \          |||,'______|
                                              ||| /          /|| I==||
                                              ||| \       __/_||  __||__
                                         -----||-/------`-._/||-o--o---o---
                                              ~~~~~'
EOF
        local -a prof_names=()
        local i=1

        # List existing profiles
        for f in "$PROFILES_DIR"/*; do
            [[ -e "$f" ]] || continue # Skip if directory is empty
            prof_names+=("$(basename "$f")")
            echo "$i) ${prof_names[-1]}"
            ((i++))
        done

        echo ""

        local new_opt=$i
        echo "$new_opt) Create New Connection"
        local edit_opt=$((i+1))
        echo "$edit_opt) Edit a Profile"
        local del_opt=$((i+2))
        echo "$del_opt) Delete a Profile"
        local quit_opt=$((i+3))
        echo "$quit_opt) Quit"

        echo ""
        local choice=""
        read -r -p "Select option: " choice

        # Validate input is an integer
        if ! [[ "$choice" =~ ^[0-9]+$ ]]; then
            echo "Invalid input. Please enter a number."
            sleep 1
            continue
        fi

        if [[ "$choice" -eq "$new_opt" ]]; then
            TARGET_IP="$(ask_for_targetip)"
            echo ""
            PORT="$(ask_for_port)"
            echo ""
            USERNAME="$(ask_for_username)"
            echo ""
            PASSWORD="$(ask_for_password)"
            PROFILE_LOADED=false
            break
        elif [[ "$choice" -eq "$edit_opt" ]]; then
            if [[ ${#prof_names[@]} -eq 0 ]]; then
                echo "No profiles to edit."
                sleep 1
                continue
            fi
            local edit_choice=""
            read -r -p "Enter profile number to edit: " edit_choice
            if [[ "$edit_choice" =~ ^[0-9]+$ ]] && [[ "$edit_choice" -ge 1 && "$edit_choice" -le ${#prof_names[@]} ]]; then
                local idx=$((edit_choice-1))
                edit_profile "${prof_names[$idx]}"
            else
                echo "Invalid profile number."
                sleep 1
            fi
            # Continues back to the main menu loop after editing
        elif [[ "$choice" -eq "$del_opt" ]]; then
            if [[ ${#prof_names[@]} -eq 0 ]]; then
                echo "No profiles to delete."
                sleep 1
                continue
            fi
            local del_choice=""
            read -r -p "Enter profile number to delete: " del_choice
            if [[ "$del_choice" =~ ^[0-9]+$ ]] && [[ "$del_choice" -ge 1 && "$del_choice" -le ${#prof_names[@]} ]]; then
                local idx=$((del_choice-1))
                rm -f "$PROFILES_DIR/${prof_names[$idx]}"
                echo "Profile '${prof_names[$idx]}' deleted."
                sleep 1
            else
                echo "Invalid profile number."
                sleep 1
            fi
        elif [[ "$choice" -eq "$quit_opt" ]]; then
            exit 0
        elif [[ "$choice" -ge 1 && "$choice" -le ${#prof_names[@]} ]]; then
            local idx=$((choice-1))
            load_profile "${prof_names[$idx]}"
            echo "Loaded profile: ${prof_names[$idx]}"
            PROFILE_LOADED=true
            break
        else
            echo "Invalid option."
            sleep 1
        fi
    done
}

run_rdp() {
    local username="$1"
    local password="$2"
    local targetip="$3"
    local port="${4:-$DEFAULT_PORT}"

    # We must resolve the absolute path so startx knows it's an executable
    local rdp_bin
    rdp_bin="$(command -v xfreerdp3)"

    if [[ -z "${DISPLAY:-}" ]]; then
        # DISPLAY is not set; Xorg is not running.
        # Start X and pass xfreerdp3 straight to it as the client application.
        startx "$rdp_bin" \
            "/u:$username" \
            "/p:$password" \
            "/v:$targetip" \
            "/port:$port" \
            /cert:ignore \
            /sound:sys:alsa \
            /clipboard \
            /f
    else
        # Xorg is already running, run normally.
        "$rdp_bin" \
            "/u:$username" \
            "/p:$password" \
            "/v:$targetip" \
            "/port:$port" \
            /cert:ignore \
            /sound:sys:alsa \
            /clipboard \
            /f
    fi
}

is_successful_rdp_exit() {
    local exit_code="$1"

    case "$exit_code" in
        0|12)
            # 0 = Clean exit, 12 = User logged off from the remote session
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

main() {
    check_dependencies

    # Setup directories
    mkdir -p "$PROFILES_DIR"
    chmod 700 "$CONFIG_DIR" 2>/dev/null || true
    chmod 700 "$PROFILES_DIR" 2>/dev/null || true

    # Keep running: after each session ends (clean exit OR error) we return
    # to the menu instead of quitting. The first pass may honor CLI arguments;
    # every later pass falls back to the interactive menu (the default screen).
    # The menu's "Quit" option is the way out.
    local first_run=true

    while true; do
        if [[ "$first_run" == true ]]; then
            get_credentials "$@"
            first_run=false
        else
            # Reset per-connection state before showing the menu again.
            TARGET_IP=""
            PORT=""
            USERNAME=""
            PASSWORD=""
            PROFILE_LOADED=false
            get_credentials
        fi

        # Safety net in case a code path left the port unset.
        [[ -z "$PORT" ]] && PORT="$DEFAULT_PORT"

        echo "Connecting to $TARGET_IP:$PORT..."
        run_rdp "$USERNAME" "$PASSWORD" "$TARGET_IP" "$PORT" > /dev/null 2> /dev/null
        local rdp_exit=$?

        # Only prompt to save if we didn't load an existing profile
        if [[ "$PROFILE_LOADED" == false ]]; then
            echo ""
            local save_ans=""
            read -r -p "Do you want to save this connection as a profile? (y/N): " save_ans
            if [[ "$save_ans" =~ ^[Yy]$ ]]; then
                local prof_name=""
                read -r -p "Enter profile name (e.g., HomePC, WorkServer): " prof_name
                if [[ -n "$prof_name" ]]; then
                    save_profile "$prof_name"
                    echo "Profile '$prof_name' saved successfully."
                else
                    echo "No name provided, skipping save."
                fi
            fi
        fi

        if is_successful_rdp_exit "$rdp_exit"; then
            echo "Connection closed..."
        else
            echo "RDP session closed with exit code $rdp_exit."
        fi

        echo ""
        read -r -p "Press Enter to return to the menu..." _
    done
}

main "$@"
